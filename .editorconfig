root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 160

[*.java]
indent_size = 4
max_line_length = 160

[*.{xml,yml,yaml,json,txt,cfg}]
indent_size = 2

[*.bat]
end_of_line = crlf

[COMMIT_EDITMSG]
max_line_length = 72
