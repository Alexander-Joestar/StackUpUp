# Auto detect text files and normalize to LF
* text=auto eol=lf

# Gradle wrapper
*.bat text eol=crlf

# Binary files - never touch
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ogg binary
*.ico binary
*.class binary
*.cfb binary
*.otf binary
*.ttf binary

# Git archives - preserve line endings
.gitattributes export-ignore
.gitignore export-ignore
